<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.VBox?>

<AnchorPane prefHeight="600.0" prefWidth="800.0" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1">
    <VBox layoutX="93.0" layoutY="57.0" prefHeight="503.0" prefWidth="615.0" spacing="10.0">
        <Label text="Create Group" />
        <TextField fx:id="groupNameField" promptText="Group Name" />
        <TextField fx:id="member1Field" promptText="Member 1 ID" />
        <TextField fx:id="member2Field" promptText="Member 2 ID" />
        <TextField fx:id="member3Field" promptText="Member 3 ID" />
        <TextField fx:id="member4Field" promptText="Member 4 ID" />
        <TextField fx:id="member5Field" promptText="Member 5 ID" />
        <ComboBox fx:id="courseComboBox" promptText="Select Course">
            <!-- Items will be populated dynamically -->
        </ComboBox>
        <Button fx:id="createGroupButton" onAction="#createGroup" text="Create Group" />
    </VBox>
</AnchorPane>
